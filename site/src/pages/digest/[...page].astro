---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { assertDigestIds } from '../../lib/content';

export async function getStaticPaths({ paginate }) {
  const all = await getCollection('digest');
  assertDigestIds(all);
  const digests = all
    .sort((a, b) => (a.data.date === b.data.date ? a.id.localeCompare(b.id) : a.data.date < b.data.date ? 1 : -1));
  return paginate(digests, { pageSize: 10 });
}
const { page } = Astro.props;
const rssUrl = new URL('digest.xml', Astro.site).toString();
---
<Base title="AI 日报">
  <div class="frame">
    <div class="list-head">
      <div class="crumb"><span class="seal-m">机</span><a href="/">首页</a><span>/</span><span>日报</span></div>
      <h1>AI 日报</h1>
      <p class="sub">AI 自动选题与摘要生成的日报栏目。全部内容为 AI 生成,每期标注所用模型与成本;与手写「文章」栏目分开。</p>
    </div>

    {page.data.length === 0 ? (
      <div class="blank-sheet" data-reveal>
        <div class="bs-lines" aria-hidden="true"><i></i><i></i><i></i></div>
        <p class="bs-state">暂无已发布日报</p>
        <p class="bs-desc">这一页还空着。第一期发布后,这里会按日期倒序列出各期,含模型、条目数与成本标注——全部内容为 AI 生成,与手写文章分开。</p>
      </div>
    ) : (
      <div>
        {page.data.map((d) => (
          <a class="row-item" href={`/digest/${d.id}/`} data-reveal>
            <h3>{d.data.date} 日报</h3>
            <div class="meta mono">{d.data.entry_count} 条 · {d.data.ai_model} · ¥{d.data.cost_cny}{d.data.cost_pending && <span class="pending"> 含未决预占,为保守上界</span>}</div>
          </a>
        ))}
        <nav class="pager" aria-label="日报分页">
          {page.url.prev
            ? <a href={page.url.prev}>← 上一页</a>
            : <span class="at-ends">← 上一页</span>}
          <span class="mono">{page.lastPage > 1 ? `第 ${page.currentPage} / ${page.lastPage} 页` : '共 1 页'}</span>
          {page.url.next
            ? <a href={page.url.next}>下一页 →</a>
            : <span class="at-ends">下一页 →</span>}
        </nav>
      </div>
    )}

    <div class="subscribe" data-reveal>
      <span class="s-title"><span class="seal-m" style="width:18px;height:18px;font-size:10px;vertical-align:-3px">机</span> 日报 RSS</span>
      <span class="s-item"><code>{rssUrl}</code>
        <button class="copy-link" type="button" data-copy={rssUrl}>复制链接</button></span>
      <p class="hint">AI 生成栏目;有新日报发布时会送达你的阅读器。</p>
    </div>
  </div>
</Base>
