---
import Header from '../components/Header.astro';
import { SITE_TITLE, SITE_DESC } from '../consts';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props { title?: string; description?: string; mainClass?: string; }
const { title, description = SITE_DESC, mainClass = '' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <!-- W1 首帧主题(ADR-0010):防夜览闪白;js 类同帧加——base.css 的
         html.js 移动端 nav 折叠原先等 body 尾 site.js 才生效,首帧渲染
         展开目录再塌成按钮,main 上移 261px(批次 3 CLS 0.288 归因)。
         内容签名由 smoke.mjs 断言 -->
    <script is:inline>try{var m=localStorage.getItem('nm-theme');if(m==='light'||m==='dark')document.documentElement.dataset.theme=m}catch(e){}document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <Header />
    <main class={mainClass}><slot /></main>
    <footer class="site frame">
      <span>© {new Date().getFullYear()} nanmu</span>
      <span><a href="/rss.xml">文章 RSS</a> · <a href="/digest.xml">日报 RSS</a></span>
    </footer>
    <!-- onerror:site.js 请求失败时摘除 .js 回退无 JS 平铺导航
         (初始化失败由 site.js 自身兜底 catch 摘除;批次 3 修正轮) -->
    <script is:inline src="/scripts/site.js" defer onerror="document.documentElement.classList.remove('js')"></script>
  </body>
</html>
