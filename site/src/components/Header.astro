---
const { pathname } = Astro.url;
const p = pathname.replace(/\/+$/, '');
const links = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '/featured/', label: '精选' },
  { href: '/all/', label: '动态' },
  { href: '/hot/', label: '热点' },
  { href: '/digest/', label: '日报' },
  { href: '/about/', label: '关于' },
];
// 首页精确匹配,栏目前缀匹配(构建期 pathname 无尾斜杠,统一归一后比较)
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '');
  return h === '' ? p === '' : p === h || p.startsWith(h + '/');
};
---
<header class="top frame">
  <a class="brand" href="/"><span class="mark">n</span><b>nanmu</b></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">目录</button>
  <nav class="main" id="main-nav" aria-label="主导航">
    {links.map((l) => (
      <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <button id="theme-btn" type="button" title="切换:跟随系统 → 昼 → 夜">跟随系统</button>
  </nav>
</header>
