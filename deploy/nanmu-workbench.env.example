# /etc/nanmu-workbench.env 结构说明(root:nanmu 0640)
# 真实凭据只进服务器本文件,不进代码/日志/文档/交接记录。
# WORKBENCH_PASSWORD_HASH = argon2id 哈希;生成(在服务器上执行,输出粘入本文件):
#   cd /opt/nanmu-workbench/app/workbench && \
#   node -e "import('@node-rs/argon2').then(a=>a.hash(process.argv[1],\
#   {type:a.argon2id})).then(h=>console.log(h))" '你的口令'
# (口令经命令行参数短暂出现在 shell 历史,生成后建议 history -c 或改用交互输入。)

NODE_ENV=production
HOST=127.0.0.1
PORT=8790
WB_BASE_URL=https://write.nanmu.xyz
WB_COOKIE_SECURE=1
WORKBENCH_PASSWORD_HASH=__填_argon2id_哈希__

# --- 目录布局(/opt/nanmu-workbench)---
WB_DRAFTS_DIR=/opt/nanmu-workbench/drafts
WB_PREVIEWS_DIR=/opt/nanmu-workbench/previews
WB_OPS_DIR=/opt/nanmu-workbench/ops
# 发布裸克隆+固定 worktree(§2.1;首次由 operations 自动 clone deploy)
WB_GIT_REPO=/opt/nanmu-workbench/repo.git
WB_GIT_WT=/opt/nanmu-workbench/repo.wt
# 预览构建同用该裸克隆(临时 worktree,用完即删)
WB_PREVIEW_REPO=/opt/nanmu-workbench/repo.git
WB_PREVIEW_BRANCH=main

# --- 远端(§2.1:github=仅备份,deploy=唯一发布入口)---
WB_REMOTE_DEPLOY=/opt/git/nanmu-blog.git
# SSH remote:服务器 ~/.ssh/ 的 deploy key(仅本仓库写权限);GitHub 侧配公钥
WB_REMOTE_GITHUB=git@github.com:nanmulimeng/nanmu-blog.git

# --- 线上确认(内容身份核对读当前 release SHA)---
WB_RELEASE_URL=https://nanmu.xyz/release.txt
