# /etc/nanmu-blog.env 结构说明(Task 25 安装;root:nanmu 0640)
# 真实密钥只进服务器本文件,不进代码/日志/文档/交接记录。
# 当前阶段(Task 25 零付费验证):所有值可为空——key 为空时授权闸门
# 按 key_missing 拒绝一切付费 attempt,这正是暂停态的正确行为。

# --- 付费(Task 26 前保持空)---
# DeepSeek API key(llm.py 只从此变量读)
DEEPSEEK_API_KEY=

# --- 发布链(Task 25 部署值)---
# 引擎专用工作副本的远端(服务器 bare repo,本地路径即可,免 SSH 自环)
NANMU_PUBLISH_REMOTE=/opt/git/nanmu-blog.git
# 线上基址(期页 URL 确认)
NANMU_SITE_BASE=https://nanmu.xyz
# 部署 SHA 文件(博客构建链产出;读不到=证据不足不确认,不误判)
NANMU_RELEASE_TXT=/var/www/nanmu-blog/current/dist/release.txt

# --- 上游(方案 A,2026-10-07):优先 NANMU_UPSTREAM_SNAPSHOT_DIR(td
#     每夜 Online Backup 备份目录)——engine 用 journalctl 任务级证据链
#     选最近成功完成的备份件(备份中/失败残留回退上一份;过旧/证据不足
#     /防线不过=E2 停止),immutable=1 只读;规则见 docs/sessions/
#     2026-10-07-plan-a-snapshot-rules.md。数据延迟:错过备份最迟次日
#     08:30 处理(≈29h),异常时无上界直至停止。NANMU_UPSTREAM_DB(单库
#     mode=ro 直读)保持兼容:活库需 -shm 写权,现权限下 E2 报缺口;
#     不改上游)---
NANMU_UPSTREAM_SNAPSHOT_DIR=/opt/topic-digest/backups
# NANMU_UPSTREAM_DB=/opt/topic-digest/data/topic-digest.db

# --- 告警(可空=仅 journal)---
# ServerChan 兼容 GET webhook,例:https://sctapi.ftqq.com/SENDKEY.send
NANMU_NOTIFY_WEBHOOK=
